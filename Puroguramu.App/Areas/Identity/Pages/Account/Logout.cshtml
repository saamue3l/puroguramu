@page "/deconnexion"
@model LogoutModel
@{
    ViewData["Title"] = "Deconnexion";
}

<div class="flex items-center justify-center h-full w-full">
    @{
        if (User.Identity!.IsAuthenticated)
        {
            <div class="flex flex-col items-center">
                <p class="font-light text-white-50">Êtes-vous sûr de vouloir vous déconnecter ?</p>
                <p class="font-light text-white-50">Si oui, cliquez sur le bouton ci-dessous.</p>
                <form class="mt-4" id="logoutForm" method="post">
                    <button type="submit" class="nav-link btn btn-link border p-2 rounded-md border-white border-opacity-50 text-white hover:opacity-50">Se deconnecter</button>
                </form>
            </div>
        }
        else
        {
            <p>Deconnexion confirmée.</p>
        }
    }
</div>