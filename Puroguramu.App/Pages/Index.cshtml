@page
@model Puroguramu.App.Pages.IndexModel
@{
    Layout = "~/Pages/Shared/_MinimalistLayout.cshtml";
    ViewBag.Title = "Accueil";
}
<div class="flex flex-col w-4/5 h-full justify-center items-center">
    <div class="flex h-80 justify-between">
        <div id="left" class="flex flex-col justify-between w-1/2">
            <h1 class="xl:text-5xl 2xl:text-6xl font-bold text-white">Maitrisez tous les langages <span id="custom-puroguramu" class="xl:text-5xl 2xl:text-6xl font-bold text-primary">.NET Core</span></h1>
            <div id="call-to-action" class="flex flex-col">
                <p class="text-lg font-light text-white-50">Inscrivez-vous et commencez tout de suite !</p>
                <p class="text-lg font-light text-white-50">Déjà membre? Connectez-vous pour continuer.</p>
            </div>
            <div>
                <a asp-area="Identity" asp-page="/Account/Login" class="inline-block">
                    <div class="px-3.5 py-3 xl:w-60 2xl:w-64 flex justify-center text-base mr-2 font-bold border-2 border-none rounded-md bg-primary-30 text-white cursor-pointer transition-transform duration-200 ease hover:translate-y-[-5px]">
                        Connexion
                    </div>
                </a>
                <a asp-area="Identity" asp-page="/Account/Register" class="inline-block">
                    <div  class="px-3.5 py-3 xl:w-60 2xl:w-64 flex justify-center text-base font-bold border-2 border-none rounded-md bg-primary text-white cursor-pointer transition-transform duration-200 ease hover:translate-y-[-5px]">
                        Inscription
                    </div>
                </a>
            </div>
        </div>
        <div id="right" class="w-1/2 flex flex-col justify-between items-end">
            <div class="mr-12">
                <p class="mb-2 text-center text-lg font-light text-white-50">Apprenez grâce à des exercices interactifs.</p>
                <p class="mb-2 text-center text-lg font-light text-white-50">Suivez votre progression en continu.</p>
                <p class="mb-2 text-center text-lg font-light text-white-50">Progressez à votre propre rythme.</p>
            </div>
            <ul class="flex justify-end flex-wrap xl:w-fit 2xl:w-4/5">
                <div class="index-box">
                    <p class="text-3xl font-bold text-white">@Model.LessonCount</p>
                    <p class="text-base font-light text-white-50">Leçons</p>
                </div>
                <div class="index-box">
                    <p class="text-3xl font-bold text-white">@Model.ExerciseCount</p>
                    <p class="text-base font-light text-white-50">Exercices</p>
                </div>
                <div class="index-box">
                    <p class="text-3xl font-bold text-white">@Model.MemberCount</p>
                    <p class="text-base font-light text-white-50">Utilisateurs</p>
                </div>
                <div class="index-box tooltip" data-tooltip="Disponible">
                    <img src="~/csharpLogo.png" alt="Logo" class="h-12"/>
                    <span class="tooltip-text absolute invisible bg-black text-white text-xs py-1 px-2 rounded transition-opacity opacity-0">Disponible</span>
                </div>
                <div class="index-box tooltip relative" data-tooltip="Bientôt disponible">
                    <img src="~/fsharpLogo.png" alt="Logo" class="h-12"/>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4 absolute bottom-0 right-0 mb-1 mr-1 opacity-50">
                        <path fill-rule="evenodd" d="M12 6.75a5.25 5.25 0 0 1 6.775-5.025.75.75 0 0 1 .313 1.248l-3.32 3.319c.063.475.276.934.641 1.299.365.365.824.578 1.3.64l3.318-3.319a.75.75 0 0 1 1.248.313 5.25 5.25 0 0 1-5.472 6.756c-1.018-.086-1.87.1-2.309.634L7.344 21.3A3.298 3.298 0 1 1 2.7 16.657l8.684-7.151c.533-.44.72-1.291.634-2.309A5.342 5.342 0 0 1 12 6.75ZM4.117 19.125a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75h-.008a.75.75 0 0 1-.75-.75v-.008Z" clip-rule="evenodd"/>
                        <path d="m10.076 8.64-2.201-2.2V4.874a.75.75 0 0 0-.364-.643l-3.75-2.25a.75.75 0 0 0-.916.113l-.75.75a.75.75 0 0 0-.113.916l2.25 3.75a.75.75 0 0 0 .643.364h1.564l2.062 2.062 1.575-1.297Z"/>
                        <path fill-rule="evenodd" d="m12.556 17.329 4.183 4.182a3.375 3.375 0 0 0 4.773-4.773l-3.306-3.305a6.803 6.803 0 0 1-1.53.043c-.394-.034-.682-.006-.867.042a.589.589 0 0 0-.167.063l-3.086 3.748Zm3.414-1.36a.75.75 0 0 1 1.06 0l1.875 1.876a.75.75 0 1 1-1.06 1.06L15.97 17.03a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
                    </svg>
                    <span class="tooltip-text absolute invisible bg-black text-white text-xs py-1 px-2 rounded transition-opacity opacity-0">Bientôt disponible</span>
                </div>
                <div class="index-box tooltip relative" data-tooltip="Bientôt disponible">
                    <img src="~/vbLogo.png" alt="Logo" class="h-12"/>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4 absolute bottom-0 right-0 mb-1 mr-1 opacity-50">
                        <path fill-rule="evenodd" d="M12 6.75a5.25 5.25 0 0 1 6.775-5.025.75.75 0 0 1 .313 1.248l-3.32 3.319c.063.475.276.934.641 1.299.365.365.824.578 1.3.64l3.318-3.319a.75.75 0 0 1 1.248.313 5.25 5.25 0 0 1-5.472 6.756c-1.018-.086-1.87.1-2.309.634L7.344 21.3A3.298 3.298 0 1 1 2.7 16.657l8.684-7.151c.533-.44.72-1.291.634-2.309A5.342 5.342 0 0 1 12 6.75ZM4.117 19.125a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75h-.008a.75.75 0 0 1-.75-.75v-.008Z" clip-rule="evenodd"/>
                        <path d="m10.076 8.64-2.201-2.2V4.874a.75.75 0 0 0-.364-.643l-3.75-2.25a.75.75 0 0 0-.916.113l-.75.75a.75.75 0 0 0-.113.916l2.25 3.75a.75.75 0 0 0 .643.364h1.564l2.062 2.062 1.575-1.297Z"/>
                        <path fill-rule="evenodd" d="m12.556 17.329 4.183 4.182a3.375 3.375 0 0 0 4.773-4.773l-3.306-3.305a6.803 6.803 0 0 1-1.53.043c-.394-.034-.682-.006-.867.042a.589.589 0 0 0-.167.063l-3.086 3.748Zm3.414-1.36a.75.75 0 0 1 1.06 0l1.875 1.876a.75.75 0 1 1-1.06 1.06L15.97 17.03a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
                    </svg>
                    <span class="tooltip-text absolute invisible bg-black text-white text-xs py-1 px-2 rounded transition-opacity opacity-0">Bientôt disponible</span>
                </div>
            </ul>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.querySelectorAll('.tooltip').forEach(item => {
            item.addEventListener('mouseenter', () => {
                const tooltipText = item.querySelector('.tooltip-text');
                tooltipText.classList.remove('invisible');
                tooltipText.classList.add('visible');
                tooltipText.style.opacity = "1";
            });

            item.addEventListener('mouseleave', () => {
                const tooltipText = item.querySelector('.tooltip-text');
                tooltipText.classList.remove('visible');
                tooltipText.classList.add('invisible');
                tooltipText.style.opacity = "0";
            });
        });
    </script>
}