@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Puroguramu.App.Pages.Teachers.LessonCardViewModel
@{
    var lessonId = Model.Lesson.IDLecon;
    var completedCount = Model.StudentsCompletedLesson.ContainsKey(lessonId) ? Model.StudentsCompletedLesson[lessonId] : 0;
}
<div class="bg-gray-900 p-2 rounded-lg mb-2 relative">
    <div class="flex items-start w-full">
        <span class="text-gray-500 text-xl font-light">@Model.Lesson.Position</span>
        <div class="ml-3 w-full">
            <p class="text-white text-xl font-light">@Model.Lesson.Intitule</p>
            <div class="flex text-primary items-center w-full">
                <p class="flex items-center justify-between mr-1">
                    @completedCount / @Model.TotalStudents
                </p>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="grey" class="w-2.5 h-2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="grey" class="w-2.5 h-2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.746 3.746 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.746 3.746 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.745 3.745 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"/>
                </svg>
                <div class="flex justify-end ml-auto space-x-1 text-gray-500">
                    @if (@Model.Lesson.Position != Model.Count)
                    {
                        <form asp-page-handler="MoveLessonDown" asp-route-lessonId="@Model.Lesson.IDLecon" method="post">
                            <div class="w-7 h-7 flex items-center justify-center hover:text-white hover:bg-gray-800 hover:rounded-lg">
                                <button type="submit">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    }
                    @if (Model.Lesson.Position != 1)
                    {
                        <form asp-page-handler="MoveLessonUp" asp-route-lessonId="@Model.Lesson.IDLecon" method="post">
                            <div class="w-7 h-7 flex items-center justify-center hover:text-white hover:bg-gray-800 hover:rounded-lg">
                                <button type="submit">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5"/>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    }
                    @if (Model.Lesson.IDStatut == 2)
                    {
                        <form asp-page-handler="HideLesson" asp-route-lessonId="@Model.Lesson.IDLecon" method="post">
                            <div class="w-7 h-7 flex items-center justify-center hover:text-white hover:bg-gray-800 hover:rounded-lg">
                                <button type="submit">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <form asp-page-handler="UnHideLesson" asp-route-lessonId="@Model.Lesson.IDLecon" method="post">
                            <div class="w-7 h-7 flex items-center justify-center hover:text-white hover:bg-gray-800 hover:rounded-lg">
                                <button type="submit">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"/>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    }
                    <a asp-page="../Teachers/EditLesson" asp-route-lessonId="@Model.Lesson.IDLecon">
                        <div class="w-7 h-7 flex items-center justify-center hover:text-white hover:bg-gray-800 hover:rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/>
                            </svg>
                        </div>
                    </a>
                    <form asp-page-handler="DeleteLesson" asp-route-lessonId="@Model.Lesson.IDLecon" method="post">
                        <div class="w-7 h-7 flex items-center justify-center hover:text-white hover:bg-gray-800 hover:rounded-lg">
                            <button type="submit">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>