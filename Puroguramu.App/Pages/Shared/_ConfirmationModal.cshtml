@model (string ModalId, string Title, string Message, string Handler, int LessonId, int ExerciseId, string CancelButtonId)

<div id="@Model.ModalId" class="hidden fixed inset-0 bg-black bg-opacity-80 overflow-y-auto h-full w-full flex items-center justify-center">
    <div class="relative mx-auto p-5 w-96 shadow-lg rounded-md bg-dark-blue">
        <div class="mt-3 text-center">
            <h3 class="text-xl font-bold text-white">@Model.Title</h3>
            <p class="text-xs font-light text-white-50 mt-2">@Model.Message</p>
            <form method="post" action="?handler=@Model.Handler">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lessonId" value="@Model.LessonId"/>
                <input type="hidden" name="exerciseId" value="@Model.ExerciseId"/>
                <div class="flex justify-around mt-4 px-7">
                    <button type="submit" class="px-4 py-2 text-black font-medium bg-white rounded-md hover:opacity-50">Confirmer</button>
                    <button type="button" id="@Model.CancelButtonId" class="px-4 py-2 text-white font-medium bg-primary rounded-md hover:opacity-50">Annuler</button>
                </div>
            </form>
        </div>
    </div>
</div>
