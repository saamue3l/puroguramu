@model Puroguramu.App.ViewModels.ExerciseProgressItem

<a asp-page="/Students/DoExercise" asp-route-lessonId="@Model.LessonId" asp-route-exerciseId="@Model.Exercise.IDExercice">
    <div class="bg-gray-900 py-2 rounded-lg mb-2 relative hover:opacity-50 cursor-pointer">
        <div class="flex items-start w-full">
            <div class="w-10 flex justify-center text-gray-500 text-xl font-light">@Model.Exercise.Position</div>
            <div class="w-full">
                <div class="flex justify-between items-center text-white text-xl font-light">
                    <p>@Model.Exercise.Titre</p>
                    <p class="italic"></p>
                </div>
                <div class="flex justify-between text-primary pt-1.5 pb-1 items-center w-full">
                    @await Html.PartialAsync("_DifficultyStars", Model.Exercise.IDDifficulte)
                    <div>
                        <p class="text-white-50">@Model.ProgressStatusName</p>
                    </div>
                </div>
            </div>
            <span class="w-10"></span>
        </div>
    </div>
</a>
