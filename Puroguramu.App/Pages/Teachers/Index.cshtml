@page "/tableau-de-bord-enseignant"
@model Puroguramu.App.Pages.Teachers.Index
@{
    ViewBag.Title = "Accueil";
}

<section class="w-4/5">
    <div class="flex justify-between items-end mt-24">
        <p class="text-white text-2xl font-bold m-0 p-0">Tableau de bord</p>
        <div class="flex items-center">
            <select class="text-white text-xs bg-dark-blue border border-white rounded-lg px-3 py-2 mr-4" id="sortOrder" onchange="sortLessons()">
                <option value="position">Trier par position</option>
                <option value="title">Trier par titre</option>
                <option value="status">Trier par status</option>
            </select>
            <button class="text-white text-xs font-bold bg-primary rounded-lg px-3 py-2" onclick="openModal()">Ajouter une leçon</button>
        </div>
    </div>

    <div class="border border-white mt-3 opacity-50"></div>

    <div class="grid grid-cols-2 gap-4 mt-3">
        <div>
            @{
                var halfCount = (int)Math.Ceiling(Model.LessonCardViewModels.Count / 2.0);
                var firstHalf = Model.LessonCardViewModels.Take(halfCount);
                var secondHalf = Model.LessonCardViewModels.Skip(halfCount);
            }
            @foreach (var lessonCardViewModel in firstHalf)
            {
                await Html.RenderPartialAsync("_LessonCard", lessonCardViewModel);
            }
        </div>
        <div>
            @foreach (var lessonCardViewModel in secondHalf)
            {
                await Html.RenderPartialAsync("_LessonCard", lessonCardViewModel);
            }
        </div>
    </div>
</section>
<form method="post" asp-page-handler="CreateLesson">
    @Html.AntiForgeryToken()
    <div id="confirmModal" class="hidden fixed items-center flex justify-center inset-0 bg-black bg-opacity-80 overflow-y-auto h-full w-full">
        <div class="relative mx-auto p-5 w-96 shadow-lg rounded-md bg-dark-blue">
            <div class="mt-3 text-center space-y-4">
                <h3 class="text-xl font-bold text-white">Ajouter une leçon</h3>
                <div class="flex justify-around px-7">
                    <input asp-for="CreateLessonInputModel.NewLessonName" type="text" class="text-white text-xs font-light bg-transparent p-2 rounded-lg mr-1 transition duration-300 ease-in-out hover:bg-gray-800 hover:text-gray-300 focus:bg-gray-800 focus:text-gray-300 focus:border-transparent focus:outline-none" placeholder="Nom de la leçon" required>
                </div>
                <button id="confirmButton" type="submit" class="px-4 py-2 text-white font-medium bg-primary rounded-md hover:opacity-50">Confirmer</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
    toastr.error('@TempData["ErrorMessage"]');
</script>
    }
    <script>
        function openModal() {
            document.getElementById('confirmModal').style.display = "flex";
        }

        function closeModal() {
            document.getElementById('confirmModal').style.display = "none";
        }

        document.getElementById('confirmModal').addEventListener('click', function(event) {
            if (event.target.id === 'confirmModal') {
                closeModal();
            }});
            
            function sortLessons() {
                var sortOrder = document.getElementById('sortOrder').value;
                window.location.href = `?sortOrder=${sortOrder}`;
            }

        document.getElementById('sortOrder').addEventListener('change', function() {
            var sortOrder = this.value;
            localStorage.setItem('sortOrder', sortOrder);
        });

        window.onload = function() {
            var sortOrder = localStorage.getItem('sortOrder');
            if (sortOrder) {
                document.getElementById('sortOrder').value = sortOrder;
            }
            };

    </script>
}