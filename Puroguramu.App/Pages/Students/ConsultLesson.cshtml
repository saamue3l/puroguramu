@page "/lecon-{lessonId:int}"
@model Puroguramu.App.Pages.Students.ConsultLesson

@{
    ViewBag.Title = Model.ViewModel.LessonTitle;
    var vm = Model.ViewModel;
}

<section class="w-4/5">
    <p class="text-white text-2xl font-bold mt-24 bg-transparent p-2 rounded-lg mr-1">@vm.LessonTitle</p>
    <p class="text-white text-sm font-light bg-transparent p-2 resize-none w-11/12 rounded-lg mr-1 overflow-y-hidden">
        @vm.LessonDescription
    </p>

    <div class="border border-white mt-3 opacity-50"></div>

    @if (!vm.HasExercises)
    {
        <p class="text-white text-lg font-light">Aucun exercice dans cette leçon</p>
    }

    <div class="grid grid-cols-2 gap-4 mt-3">
        <div>
            @foreach (var exercise in vm.FirstColumnExercises)
            {
                @await Html.PartialAsync("_ExerciseProgressCard", exercise)
            }
        </div>
        <div>
            @foreach (var exercise in vm.SecondColumnExercises)
            {
                @await Html.PartialAsync("_ExerciseProgressCard", exercise)
            }
        </div>
    </div>
</section>
