@page "/lecon-{lessonId:int}"
@model Puroguramu.App.Pages.Students.ConsultLesson
@{
    ViewBag.Title = Model.Lesson.Intitule;
}

<section class="w-4/5">
    <p class="text-white text-2xl font-bold mt-24 bg-transparent p-2 rounded-lg mr-1">@Model.Lesson.Intitule</p>
    <p class="text-white text-sm font-light bg-transparent p-2 resize-none w-11/12 rounded-lg mr-1 overflow-y-hidden">
        @Model.Lesson.Description
    </p>

    <div class="border border-white mt-3 opacity-50"></div>

    @if (!Model.ExercisesWithProgress.Any())
    {
        <p class="text-white text-lg font-light">Aucun exercice dans cette leçon</p>
    }
    <div class="grid grid-cols-2 gap-4 mt-3">
        @{
            var halfCount = (int)Math.Ceiling(Model.ExercisesWithProgress.Count / 2.0);
            var firstHalf = Model.ExercisesWithProgress.Take(halfCount);
            var secondHalf = Model.ExercisesWithProgress.Skip(halfCount);
        }
        <div>
            @foreach (var exercise in firstHalf)
            {
                <a asp-page="/Students/DoExercise" asp-route-lessonId="@Model.Lesson.IDLecon" asp-route-exerciseId="@exercise.Exercise.IDExercice">
                    <div class="bg-gray-900 py-2 rounded-lg mb-2 relative hover:opacity-50 cursor-pointer">
                        <div class="flex items-start w-full">
                            <div class="w-10 flex justify-center text-gray-500 text-xl font-light">@exercise.Exercise.Position</div>
                            <div class="w-full">
                                <div class="flex justify-between items-center text-white text-xl font-light">
                                    <p>@exercise.Exercise.Titre</p>
                                    <p class="italic"></p>
                                </div>
                                <div class="flex justify-between text-primary pt-1.5 pb-1 items-center w-full">
                                    <div class="flex text-primary items-center">
                                        @for (int j = 0; j < @exercise.Exercise.IDDifficulte; j++)
                                        {
                                            <div class="mr-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/>
                                                </svg>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <p class="text-white-50">@exercise.Progress.ProgressStatus.Nom</p>
                                    </div>
                                </div>
                            </div>
                            <span class="w-10"></span>
                        </div>
                    </div>
                </a>
            }
        </div>
        <div>
            @foreach (var exercise in secondHalf)
            {
                <a asp-page="/Students/DoExercise" asp-route-lessonId="@Model.Lesson.IDLecon" asp-route-exerciseId="@exercise.Exercise.IDExercice">
                    <div class="bg-gray-900 py-2 rounded-lg mb-2 relative hover:opacity-50 cursor-pointer">
                        <div class="flex items-start w-full">
                            <div class="w-10 flex justify-center text-gray-500 text-xl font-light">@exercise.Exercise.Position</div>
                            <div class="w-full">
                                <div class="flex justify-between items-center text-white text-xl font-light">
                                    <p>@exercise.Exercise.Titre</p>
                                    <p class="italic"></p>
                                </div>
                                <div class="flex justify-between text-primary pt-1.5 pb-1 items-center w-full">
                                    <div class="flex text-primary items-center">
                                        @for (int j = 0; j < @exercise.Exercise.IDDifficulte; j++)
                                        {
                                            <div class="mr-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/>
                                                </svg>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <p class="text-white-50">@exercise.Progress.ProgressStatus.Nom</p>
                                    </div>
                                </div>

                            </div>
                            <span class="w-10"></span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@section Scripts {

}