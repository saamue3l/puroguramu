@page "/tableau-de-bord-etudiant"
@model Puroguramu.App.Pages.Students.Index

@{
    ViewBag.Title = "Accueil";
    var vm = Model.ViewModel;
}

<section class="w-4/5">
    <div class="flex justify-between items-end mt-24">
        <p class="text-white text-2xl font-bold m-0 p-O">Tableau de bord</p>
        <div class="flex items-center">
            @await Html.PartialAsync("_DashboardActionButton", ("Continuer exercice", "ContinueExercise", vm.HasLastAttemptedExercise))
            @await Html.PartialAsync("_DashboardActionButton", ("Prochain exercice", "NextExercise", vm.HasNextExercise))
        </div>
    </div>

    <div class="border border-white mt-3 opacity-50"></div>

    @if (!vm.HasLessons)
    {
        <p class="text-white text-lg font-light">Aucunes leçons</p>
    }

    <div class="grid grid-cols-2 gap-4 mt-3">
        <div>
            @foreach (var lesson in vm.FirstColumnLessons)
            {
                @await Html.PartialAsync("_LessonProgressCard", lesson)
            }
        </div>
        <div>
            @foreach (var lesson in vm.SecondColumnLessons)
            {
                @await Html.PartialAsync("_LessonProgressCard", lesson)
            }
        </div>
    </div>
</section>
