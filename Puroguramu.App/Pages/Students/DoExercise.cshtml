@page "/lecon-{lessonId:int}/exercice-{exerciseId:int}"
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Puroguramu.App.Pages.Students.DoExercise

@{
    ViewBag.Title = Model.ViewModel.ExerciseTitle;
    var vm = Model.ViewModel;
}

<section class="w-4/5">
    <div class="flex items-center mt-16">
        <p class="text-white text-2xl font-bold bg-transparent p-2 rounded-lg mr-1">@vm.ExerciseTitle</p>
        @await Html.PartialAsync("_DifficultyStars", vm.DifficultyLevel)
    </div>

    <p class="text-white text-sm font-light bg-transparent p-2 resize-none w-11/12 rounded-lg mr-1 overflow-y-hidden">
        @vm.ExerciseStatement
    </p>

    <div class="border border-white mt-3 opacity-50"></div>

    <div class="flex justify-between w-full mt-2">
        <div class="flex w-1/2">
            <p class="text-lg font-light text-white-50">Modèle</p>
        </div>
        @if (vm.CanShowSolution)
        {
            <div class="flex w-1/2 ml-4">
                <p class="text-lg font-light text-white-50">Solution</p>
            </div>
        }
    </div>

    <div class="w-full flex justify-between">
        @if (vm.CanShowSolution)
        {
            <div class="flex justify-between w-full">
                <div class="flex flex-col w-2/4 mr-2">
                    <div id="codeForm">
                        <div id="codeEditor" class="h-72 py-4 pr-2 rounded-lg" data-stub="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(vm.CurrentStub))"></div>
                        <textarea id="codeInputArea" name="UserCode" style="display: none;"></textarea>
                    </div>
                </div>
                <div class="flex flex-col w-2/4 ml-2">
                    <div id="solutionEditor" class="h-72 py-4 pr-2 rounded-lg" data-solution="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(vm.Solution))"></div>
                    <textarea id="solutionInputArea" name="UserCode" style="display: none;"></textarea>
                </div>
            </div>
        }
        else
        {
            <div class="flex justify-between w-3/4">
                <div class="flex flex-col w-full mr-2">
                    <div id="codeForm">
                        <div id="codeEditor" class="h-72 py-4 pr-2 rounded-lg" data-stub="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(vm.CurrentStub))"></div>
                        <textarea id="codeInputArea" name="UserCode" style="display: none;"></textarea>
                    </div>
                </div>
            </div>
            <div id="testResults" class="flex flex-col w-1/4 h-72 bg-ide-theme p-4 text-white text-xs rounded-lg">
            </div>
        }
    </div>

    <div class="flex justify-between mt-2">
        <div class="w-2/4 pr-4">
            @if (vm.CanSubmit)
            {
                <button id="resetButton" type="button" class="px-4 mr-1 py-2 bg-dark-blue border border-white border-opacity-50 text-white rounded-lg hover:opacity-50">Reset</button>
                <button id="solutionButton" type="button" class="px-4 py-2 bg-dark-blue border border-white border-opacity-50 text-white rounded-lg hover:opacity-50">Solution</button>
            }
        </div>

        @if (vm.IsCompleted || vm.IsAbandoned)
        {
            <div class="flex justify-end w-2/4">
                @await Html.PartialAsync("_StatusBadge", (vm.StatusText, vm.StatusColorClass))
                @await Html.PartialAsync("_NextExerciseButton", vm.NextExercise)
            </div>
        }
        else
        {
            <button id="submitButton" type="button" data-exercise-id="@vm.ExerciseId" class="w-1/4 px-4 py-2 bg-primary text-white rounded-lg hover:opacity-50">Tester le code</button>
        }
    </div>
</section>

@if (vm.CanSubmit)
{
    @await Html.PartialAsync("_ConfirmationModal", (
        ModalId: "resetConfirmModal",
        Title: "Êtes-vous sûr de vouloir réinitialiser le code ?",
        Message: "Cette action restaurera le code d'origine de l'exercice.",
        Handler: "Reset",
        LessonId: vm.LessonId,
        ExerciseId: vm.ExerciseId,
        CancelButtonId: "cancelResetButton"
    ))

    @await Html.PartialAsync("_ConfirmationModal", (
        ModalId: "solutionConfirmModal",
        Title: "Êtes-vous sûr de vouloir afficher la solution ?",
        Message: "Vous n'avez pas encore validé cet exerice, afficher la solution résultera en l'abandon de l'exercice.",
        Handler: "Abandon",
        LessonId: vm.LessonId,
        ExerciseId: vm.ExerciseId,
        CancelButtonId: "cancelSolutionButton"
    ))
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.4.12/ace.js"></script>
    @Html.AntiForgeryToken()
    <script src="~/js/doExercise.js"></script>
}
