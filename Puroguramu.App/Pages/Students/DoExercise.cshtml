@page "/lecon-{lessonId:int}/exercice-{exerciseId:int}"
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Puroguramu.App.Pages.Students.DoExercise

@{
    ViewBag.Title = @Model.ExerciseObject.Titre;
}

<section class="w-4/5">
    <div class="flex items-center mt-16">
        <p class="text-white text-2xl font-bold bg-transparent p-2 rounded-lg mr-1">@Model.ExerciseObject.Titre</p>
        <div class="flex text-primary items-center">
            @for (int j = 0; j < @Model.ExerciseObject.IDDifficulte; j++)
            {
                <div class="mr-1">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/>
                    </svg>
                </div>
            }
        </div>
    </div>
    <p class="text-white text-sm font-light bg-transparent p-2 resize-none w-11/12 rounded-lg mr-1 overflow-y-hidden">
        @Model.ExerciseObject.Enonce
    </p>

    <div class="border border-white mt-3 opacity-50"></div>

    <div class="flex justify-between w-full mt-2">
        <div class="flex w-1/2">
            <p class="text-lg font-light text-white-50">Modèle</p>
        </div>
        @if (Model.Progress.IDStatut == 3 || Model.Progress.IDStatut == 4)
        {
            <div class="flex w-1/2 ml-4">
                <p class="text-lg font-light text-white-50">Solution</p>
            </div>
        }
    </div>
    <div class="w-full flex justify-between">
        @if (Model.Progress.IDStatut == 3 || Model.Progress.IDStatut == 4)
        {
            <div class="flex justify-between w-full">
                <div class="flex flex-col w-2/4 mr-2">
                    <div id="codeForm">
                        <div id="codeEditor" class="h-72 py-4 pr-2 rounded-lg"></div>
                        <textarea id="codeInputArea" name="UserCode" style="display: none;"></textarea>
                    </div>
                </div>
                <div class="flex flex-col w-2/4 ml-2">
                    <div id="solutionEditor" class="h-72 py-4 pr-2 rounded-lg"></div>
                    <textarea id="solutionInputArea" name="UserCode" style="display: none;"></textarea>
                </div>
            </div>
        }
        else
        {
            <div class="flex justify-between w-3/4">
                <div class="flex flex-col w-full mr-2">
                    <div id="codeForm">
                        <div id="codeEditor" class="h-72 py-4 pr-2 rounded-lg"></div>
                        <textarea id="codeInputArea" name="UserCode" style="display: none;"></textarea>
                    </div>
                </div>
            </div>
            <div id="testResults" class="flex flex-col w-1/4 h-72 bg-ide-theme p-4 text-white text-xs rounded-lg">
            </div>
        }
    </div>

    <div class="flex justify-between mt-2">
        <div class=" w-2/4 pr-4">
            @if (Model.Progress.IDStatut != 3 && Model.Progress.IDStatut != 4)
            {
                <button id="resetButton" type="button" class="px-4 mr-1 py-2 bg-dark-blue border border-white border-opacity-50 text-white rounded-lg hover:opacity-50">Reset</button>
                <button id="solutionButton" type="button" class="px-4 py-2 bg-dark-blue border border-white border-opacity-50 text-white rounded-lg hover:opacity-50">Solution</button>
            }
        </div>

        @if (Model.Progress.IDStatut == 3)
        {
            <div class="flex justify-end w-2/4">
                <div class="flex justify-center items-center text-white rounded-lg bg-custom-green px-4 py-2">
                    Réussi
                </div>
                @if (Model.NextExercise != null)
                {
                    <a asp-page="/Students/DoExercise" asp-route-lessonId="@Model.NextExercise.IDLecon" asp-route-exerciseId="@Model.NextExercise.IDExercice" class="ml-2 flex justify-center px-4 py-2 bg-dark-blue border border-white border-opacity-50 text-white rounded-lg hover:opacity-50">
                        <p class="pr-2">Prochain exercice</p>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                            <path fill-rule="evenodd" d="M12.97 3.97a.75.75 0 0 1 1.06 0l7.5 7.5a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 1 1-1.06-1.06l6.22-6.22H3a.75.75 0 0 1 0-1.5h16.19l-6.22-6.22a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
                        </svg>
                    </a>
                }
                else
                {
                    <div class="ml-2 flex justify-center px-4 py-2 bg-dark-blue border border-white border-opacity-50 text-white rounded-lg opacity-50">
                        <p class="pr-2">Pas d'exercice suivant</p>
                    </div>
                }
            </div>
        }
        else if (Model.Progress.IDStatut == 4)
        {
            <div class="flex justify-end w-2/4">
                <div class="flex justify-center items-center text-white rounded-lg bg-custom-red px-4 py-2">
                    Abandonné
                </div>
                @if (Model.NextExercise != null)
                {
                    <a asp-page="/Students/DoExercise" asp-route-lessonId="@Model.NextExercise.IDLecon" asp-route-exerciseId="@Model.NextExercise.IDExercice" class="ml-2 flex justify-center px-4 py-2 bg-dark-blue border border-white border-opacity-50 text-white rounded-lg hover:opacity-50">
                        <p class="pr-2">Prochain exercice</p>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                            <path fill-rule="evenodd" d="M12.97 3.97a.75.75 0 0 1 1.06 0l7.5 7.5a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 1 1-1.06-1.06l6.22-6.22H3a.75.75 0 0 1 0-1.5h16.19l-6.22-6.22a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
                        </svg>
                    </a>
                }
                else
                {
                    <div class="ml-2 flex justify-center px-4 py-2 bg-dark-blue border border-white border-opacity-50 text-white rounded-lg opacity-50">
                        <p class="pr-2">Pas d'exercice suivant</p>
                    </div>
                }
            </div>
        }
        else
        {
            <button id="submitButton" type="button" class="w-1/4 px-4 py-2 bg-primary text-white rounded-lg hover:opacity-50">Tester le code</button>
        }

    </div>
</section>


<div id="resetConfirmModal"  class="hidden fixed inset-0 bg-black bg-opacity-80 overflow-y-auto h-full w-full flex items-center justify-center">
    <div class="relative mx-auto p-5 w-96 shadow-lg rounded-md bg-dark-blue">
        <div class="mt-3 text-center">
            <h3 class="text-xl font-bold text-white">Êtes-vous sûr de vouloir afficher la solution ?</h3>
            <p class="text-xs font-light text-white-50 mt-2">Vous n'avez pas encore validé cet exerice, afficher la solution résultera en l'abandon de l'exercice.</p>
            <form method="post" action="?handler=Reset">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lessonId" value="@Model.Lesson.IDLecon.ToString()"/>
                <input type="hidden" name="exerciseId" value="@Model.ExerciseObject.IDExercice.ToString()"/>
                <div class="flex justify-around mt-4 px-7">
                    <button type="submit" class="px-4 py-2 text-black font-medium bg-white rounded-md hover:opacity-50">Confirmer</button>
                    <button type="button" id="cancelResetButton" class="px-4 py-2 text-white font-medium bg-primary rounded-md hover:opacity-50">Annuler</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="solutionConfirmModal"  class="hidden fixed inset-0 bg-black bg-opacity-80 overflow-y-auto h-full w-full flex items-center justify-center">
    <div class="relative mx-auto p-5 w-96 shadow-lg rounded-md bg-dark-blue">
        <div class="mt-3 text-center">
            <h3 class="text-xl font-bold text-white">Êtes-vous sûr de vouloir afficher la solution ?</h3>
            <p class="text-xs font-light text-white-50 mt-2">Vous n'avez pas encore validé cet exerice, afficher la solution résultera en l'abandon de l'exercice.</p>
            <form method="post" action="?handler=Abandon">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lessonId" value="@Model.Lesson.IDLecon.ToString()"/>
                <input type="hidden" name="exerciseId" value="@Model.ExerciseObject.IDExercice.ToString()"/>
                <div class="flex justify-around mt-4 px-7">
                    <button type="submit" class="px-4 py-2 text-black font-medium bg-white rounded-md hover:opacity-50">Confirmer</button>
                    <button type="button" id="cancelSolutionButton" class="px-4 py-2 text-white font-medium bg-primary rounded-md hover:opacity-50">Annuler</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.4.12/ace.js"></script>
    <script>

        document.addEventListener('DOMContentLoaded', function() {
            let toastrConfig = localStorage.getItem('toastr');
            if (toastrConfig) {
                toastrConfig = JSON.parse(toastrConfig);
                toastr[toastrConfig.type](toastrConfig.message);
                localStorage.removeItem('toastr');
            }

            let testResults = localStorage.getItem('testResults');

            if (testResults) {
                testResults = JSON.parse(testResults);
                let testResultsHtml = '';
                let first = true;
                testResults.forEach(function(test) {

                    if (!first) {
                        testResultsHtml += '<div class="border border-white my-1 opacity-50"></div>';
                    } else {
                        first = false;
                    }
                    let resultClass = test.status === 'Passed' ? 'text-custom-green' : 'text-custom-red';
                    let resultText = test.status === 'Failed' ? test.error : test.status;
                    testResultsHtml += `<div class="flex flex-col">
                        <p>${test.label}</p>
                        <p class="${resultClass}">${resultText}</p>
                    </div>`;
                });
                $('#testResults').html(testResultsHtml);

                localStorage.removeItem('testResults');
                localStorage.removeItem('testStatus');
            }

            let userEditor = ace.edit("codeEditor");
            userEditor.setTheme("ace/theme/dracula");
            userEditor.session.setMode("ace/mode/csharp");
            userEditor.setOption("showPrintMargin", false);
            userEditor.session.setValue(@Html.Raw(Json.Serialize(Model.Stub)));


            let solutionEditorElement = document.getElementById('solutionEditor');
            if (solutionEditorElement) {
                let solutionEditor = ace.edit("solutionEditor");
                if (solutionEditor) {
                    solutionEditor.setTheme("ace/theme/dracula");
                    solutionEditor.session.setMode("ace/mode/csharp");
                    solutionEditor.setOption("showPrintMargin", false);
                    solutionEditor.session.setValue(@Html.Raw(Json.Serialize(Model.Solution)));
                    solutionEditor.setReadOnly(true);
                }
            }

            let resetButtonElement = document.getElementById('resetButton');
            if (resetButtonElement) {
                resetButtonElement.addEventListener('click', function(e) {
                    document.getElementById('codeEditor').style.opacity = '0.5';
                    document.getElementById('resetConfirmModal').classList.remove('hidden');
                });
            }

            let cancelButtonElement = document.getElementById('cancelResetButton');
            if (cancelButtonElement) {
                cancelButtonElement.addEventListener('click', function() {
                    document.getElementById('codeEditor').style.opacity = '1';
                    document.getElementById('resetConfirmModal').classList.add('hidden');
                });
            }

            let confirmResetButtonElement = document.getElementById('confirmResetButton');
            if (confirmResetButtonElement) {
                confirmResetButtonElement.addEventListener('click', function() {
                    let editor = ace.edit("codeEditor");
                    document.getElementById('codeEditor').style.opacity = '1';
                    editor.session.setValue(@Html.Raw(Json.Serialize(Model.OriginalStub)));
                    document.getElementById('resetConfirmModal').classList.add('hidden');
                });
            }

            let solutionButtonElement = document.getElementById('solutionButton');
            if (solutionButtonElement) {
                solutionButtonElement.addEventListener('click', function(e) {
                    document.getElementById('codeEditor').style.opacity = '0.5';
                    document.getElementById('solutionConfirmModal').classList.remove('hidden');
                });
            }

            let cancelSolutionButtonElement = document.getElementById('cancelSolutionButton');
            if (cancelSolutionButtonElement) {
                cancelSolutionButtonElement.addEventListener('click', function() {
                    document.getElementById('codeEditor').style.opacity = '1';
                    document.getElementById('solutionConfirmModal').classList.add('hidden');
                });
            }


            $('#submitButton').click(function() {
                let editor = ace.edit("codeEditor");
                let submitButton = $(this);
                let originalButtonHtml = submitButton.html();
                submitButton.addClass('cursor-not-allowed no-hover-opacity');
                submitButton.html('<div class="flex justify-center"><svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"> <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle> <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path> </svg></div>');

                let userCode = editor.getValue();
                $('#codeInputArea').val(userCode);
                let UpdateProgressInputModel = {
                    UserCode: userCode,
                    ExerciseId: @Model.ExerciseObject.IDExercice
                };
                $.ajax({
                    url: '?handler=UpdateProgress',
                    type: 'POST',
                    data: JSON.stringify(UpdateProgressInputModel),
                    contentType: 'application/json',
                    headers: {
                        RequestVerificationToken: $('input:hidden[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        let status = response.status;
                        let testResults = response.results;

                        localStorage.setItem('testResults', JSON.stringify(testResults));

                        if (status === "Passed") {
                            localStorage.setItem('toastr', JSON.stringify({type: 'success', message: 'Exercice validé!'}));
                        } else if (status === "Failed") {
                            localStorage.setItem('toastr', JSON.stringify({type: 'error', message: 'Exercice raté!'}));
                        } else {
                            localStorage.setItem('toastr', JSON.stringify({type: 'error', message: status}));
                        }
                        window.location.reload();
                    },
                    error: function(xhr, status, error) {
                        localStorage.setItem('toastr', JSON.stringify({type: 'error', message: 'Erreur de soumission!'}));
                        window.location.reload();
                    },
                    complete: function(xhr, status) {

                        submitButton.removeClass('cursor-not-allowed no-hover-opacity').html(originalButtonHtml);
                    }
                });
                return false;
            });


        });
    </script>
}