@page "/profil"
@model Puroguramu.App.Pages.UserProfile
@{
    ViewData["Title"] = "Mon profil";
}

<div class="flex items-center justify-center h-full w-full">
    <div class="relative mx-auto w-96 rounded-md bg-dark-blue">
        <div class="mt-3 text-center">
            <h3 class="text-xl font-bold text-white">Mon profil</h3>
            <div class="flex mt-4 px-4 py-2 flex-col border border-white rounded-md border-opacity-50">
                <div class="flex flex-col items-start">
                    <p class="text-white text-xs opacity-50">Email</p>
                    <p class="text-white font-bold">@Model.CurrentUser.Email</p>
                </div>
                <div class="flex flex-col items-start mt-4">
                    <p class="text-white text-xs opacity-50">Matricule</p>
                    <p class="text-white font-bold">@Model.CurrentUser.UserName</p>
                </div>
                <div class="flex flex-col items-start mt-4">
                    <p class="text-white text-xs opacity-50">Nom</p>
                    <p class="text-white font-bold">@Model.CurrentUser.Nom</p>
                </div>
                <div class="flex flex-col items-start mt-4">
                    <p class="text-white text-xs opacity-50">Prenom</p>
                    <p class="text-white font-bold">@Model.CurrentUser.Prenom</p>
                </div>
                <div class="flex flex-col items-start mt-4">
                    <p class="text-white text-xs opacity-50">Groupe</p>
                    <p class="text-white font-bold">@Model.UserGroup.Nom</p>
                </div>
                <div class="flex flex-col items-start mt-4">
                    <p class="text-white text-xs opacity-50">Photo de profil</p>
                    @if (@Model.CurrentUser.Image != null)
                    {
                    <img src="@Model.CurrentUser.Image" alt="Profile Image" class="w-7 h-7 rounded-full" />
                    }
                    else
                    {
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="white" class="w-7 h-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                    </svg>
                    }
                </div>
            </div>
            <div class="flex justify-center items-center mt-2">
                <a asp-page="/Account/Manage/Index" asp-area="Identity" class="text-primary text-xs hover:opacity-50">Modifier le profil</a>
            </div>
        </div>
    </div>
</div>